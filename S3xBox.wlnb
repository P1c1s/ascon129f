{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\n(* S3X-box*)\nivs = {v1, v2, v3, v4, v5, v6};\nks = {k1, k2, k3};\niv = {1, 1, 1, 1, 1, 1};\nk = {0, 1, 1};\n(* Funzione SBox*)\nshiftRows[s_List] := s[[ {2, 3, 1} ]]\nshiftColumns[s_List] := Transpose[s]\nsubstitution[s_List] := PolynomialMod[\n      Partition[{\n            s[[1]][[1]] *s[[2]][[2]]*s[[1]][[2]]+ s[[1]][[2]], \n            s[[1]][[2]]*s[[2]][[1]] + s[[1]][[2]]*s[[1]][[1]], \n            s[[2]][[1]]*s[[1]][[3]], \n            s[[1]][[1]]*s[[2]][[2]]*s[[1]][[2]],\n          s[[1]][[1]] + s[[1]][[2]]*s[[3]][[3]], \n            s[[1]][[2]]*s[[2]][[1]] + s[[1]][[2]], \n            s[[3]][[1]]*s[[1]][[1]] + s[[1]][[2]]*s[[2]][[1]], \n            s[[1]][[1]]*s[[2]][[2]] + s[[3]][[1]]*s[[3]][[2]] + \n          s[[2]][[1]]*s[[2]][[3]] + s[[2]][[3]],\n          s[[3]][[2]] + s[[1]][[3]]*s[[2]][[2]]\n          }, 3], \n      2\n    ]\n \n(*substitution2[s_List]:=Module[{a,b,c,d,e,f,g,h,i}, {{a,b,c}, {d,e,f},{g,h,i}}=s;\nMod[{{a b,},{},{}},2]\n]\n*)\n(*Crea una matrice 3x3 combiando IV e K*)\nStruct[iv_, k_] := Append[Partition[iv, 3], k];\n(*Defisce la S-Box*)\nS3xBox[iv_, k_] := substitution[shiftColumns[shiftRows[Struct[iv, k]]]];\n\n(*VARIABILI PER generatoreComb3*)\n\n        \n(*GENERA GLI IV*)\ngeneratoreComb3[maxterm_List] := Module[{d, zv},\n  d = Length[maxterm];\n  zv = Table[0, 6];\n  \n  Map[\n    Module[{ztmp = zv},\n      ztmp[[maxterm]] = IntegerDigits[#, 2, d];\n      ztmp\n    ] &, \n    Range[0, 2^d - 1]\n  ]\n]\n\n\n\nMatrixOr[a_List,b_List] := Mod[a+b + a*b,2]\n\nTestLinearita2[key1_List,key2_List,iv_List]:=\nMod[\nTotal[Map[S3xBox [#, key1] &, iv ]]+\nTotal[Map[S3xBox [#, key2] &, iv ]]+\nTotal[Map[S3xBox [#, ConstantArray[0,Length[key1]]] &, iv ]] +  (*alpha zero*)\nTotal[Map[S3xBox[#, key1 + key2] &, iv]]       (*elelmento di ugualianza*)\n,2]\n\n(*cubeoffline-> se BLR ha successo, si fanno xor variazioni del maxterm con k1 (m1), poi k2 (m2), poi k3(m3)*)\n(*per matrice dei coefficienti -> [m1[0][0], m2[0][0], m3[0][0]], [m1[0][1]....], , escludendo elementi 0,0,0*)\n\nPrint[\"STAMPA simbolico\"]\nS3xBox[ivs,ks] //MatrixForm\n\n\n(*Prodotto cartesiano chiavi random*)\nKeyPairAll = Permutations[Rest @ Tuples[{0, 1}, #1], {#2}] &;\n\n\n(*Restituisce una matrice di zero ed uno rispetto a BLR (iterato)*)\nCalcolaLineaMaxterm[mt_] := Fold[\n   MatrixOr, \n   TestLinearita2[#1, #2, generatoreComb3[{mt}]] & @@@ KeyPairAll[3, 2]\n];\n\n(* CI SERVIRA' PER AUTOMATIZZARE IL TUTTO*)\nmaxterms={{4},{6}};\n\n(* Applica a tutta la lista di maxterm *)\nrisultati = CalcolaLineaMaxterm /@ {4,6};\npositionZeroLista = Map[Position[#, 0] &, risultati];\n\n\nGeneraTriade[iv_, keys_] := Module[{alpha0},\n   (* Matrice 3x3 per la chiave nulla *)\n   alpha0 = Mod[Total[S3xBox[#, {0, 0, 0}] & /@ iv], 2];\n\n   (*Calcolo per ciascuna chiave *)\n   Map[\n      Function[k, Mod[Total[S3xBox[#, k] & /@ iv] + alpha0, 2]], \n      keys\n   ]\n]\n\n(*Definizione delle chiavi unitarie per la triade*)\nkeysUnit = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};\n\n\n(*Lista elementi [S(v#,k1),S(v#,k2),S(v#,k3)] iterando i maxterm*)\nTriadiLista = Map[GeneraTriade[generatoreComb3[#], keysUnit] &, maxterms];\n\n\n\n(* Applicazione con MapThread su tutte le triadi e le relative liste di indici *)\nmatriceCoeffLista = MapThread[\n   Function[{triade, indici},\n      (* triade[[1]] è m1, triade[[2]] è m2, triade[[3]] è m3 *)\n      {triade[[1, #1, #2]], triade[[2, #1, #2]], triade[[3, #1, #2]]} & @@@ indici\n   ],\n   {TriadiLista, positionZeroLista}\n];\n\n\nCUBEONLINE[iv_List,key_List]:=  Mod[Total[Map[S3xBox [#, key] &, iv ]]+Total[Map[S3xBox [#, {0,0,0}] &, iv ]],2]\n(* Genera una lista di matrici 3x3 dei termini noti, una per ogni maxterm *)\nterminiNotiLista = Map[\n   CUBEONLINE[generatoreComb3[#], k] &, \n   maxterms\n];\n\n(* Estrazione parallela degli elementi specificati dalle coordinate di ciascuna matrice *)\nterminiNotiLista = MapThread[\n   Function[{matriceTN, indici},\n      matriceTN[[#1, #2]] & @@@ indici\n   ],\n   {terminiNotiLista, positionZeroLista}\n];\n\n\n\nPrint[\"SISTEMA FINALE\"]\nMC=Flatten[matriceCoeffLista,1];\nTN=Flatten[terminiNotiLista,1];\nPrint[MatrixForm[MC] ,\" x \",MatrixForm[{k1,k2,k3}],\" = \",MatrixForm[TN]]\nPrint[\"Bit della chiave: \", LinearSolve[MC,TN]]\n",
   "languageId": "wolfram",
   "outputs": [
