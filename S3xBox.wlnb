       "data": "<div class=\"wexpr\"><wrow><w></w><wb>(</wb><w>⁠</w><wgrid style=\"grid-template-columns:repeat(3,max-content);\"><w><wrow><w></w><w>k1</w><w>+</w><wrow><w></w><w>k1</w><w></w><w>k2</w><w></w><w>v4</w></wrow></wrow></w><w><wrow><w></w><wrow><w></w><w>k1</w><w></w><w>v4</w></wrow><w>+</w><wrow><w></w><w>k1</w><w></w><w>v5</w></wrow></wrow></w><w><wrow><w></w><w>v1</w><w></w><w>v5</w></wrow></w><w><wrow><w></w><w>k1</w><w></w><w>k2</w><w></w><w>v4</w></wrow></w><w><wrow><w></w><wrow><w></w><w>k1</w><w></w><w>v3</w></wrow><w>+</w><w>v4</w></wrow></w><w><wrow><w></w><w>k1</w><w>+</w><wrow><w></w><w>k1</w><w></w><w>v5</w></wrow></wrow></w><w><wrow><w></w><wrow><w></w><w>k1</w><w></w><w>v5</w></wrow><w>+</w><wrow><w></w><w>v4</w><w></w><w>v6</w></wrow></wrow></w><w><wrow><w></w><w>v2</w><w>+</w><wrow><w></w><w>k2</w><w></w><w>v4</w></wrow><w>+</w><wrow><w></w><w>v2</w><w></w><w>v5</w></wrow><w>+</w><wrow><w></w><w>k3</w><w></w><w>v6</w></wrow></wrow></w><w><wrow><w></w><w>k3</w><w>+</w><wrow><w></w><w>k2</w><w></w><w>v1</w></wrow></wrow></w></wgrid><w>⁠</w><wb>)</wb></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "MatrixForm[{{k1 + k1*k2*v4, k1*v4 + k1*v5, v1*v5}, {k1*k2*v4, k1*v3 + v4, k1 + k1*v5}, {k1*v5 + v4*v6, v2 + k2*v4 + v2*v5 + k3*v6, k3 + k2*v1}}]",
