{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\n\n(* Import delle funzioni che definiscono Ascon *)\nDirectory[]\nGet[\"/Users/sicmic/Desktop/UNIVERSITA/Crittografia/ascon129f/Librerie/Ascon.wl\"]\n",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "/",
       "mime": "text/html"
      }
     ],
     "id": "6b828131-e693-4de3-8742-543e9e83e1e3"
