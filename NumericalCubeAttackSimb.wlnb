    {
     "items": [
      {
       "data": "<pre>Stato simbolico dopo 1 Round, andando avanti con i round successivi, si nota\\\n \n&gt;   subito un fenomeno tipico dell'analisi simbolica della S-box e delle\\\n \n&gt;   permutazioni in Ascon: il polinomio esplode (ossia si verifica\\\n \n&gt;   un'esplosione algebrica del polinomio)\n</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "\"Stato simbolico dopo 1 Round, andando avanti con i round successivi, si nota\\\\\\n \\n>   subito un fenomeno tipico dell'analisi simbolica della S-box e delle\\\\\\n \\n>   permutazioni in Ascon: il polinomio esplode (ossia si verifica\\\\\\n \\n>   un'esplosione algebrica del polinomio)\\n\"",
       "mime": "text/plain"
      }
