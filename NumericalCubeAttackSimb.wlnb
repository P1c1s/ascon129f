{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\n\n(* Import delle funzioni che definiscono Ascon *)\nGet[\"/home/lorenzo/Documenti/GitHubProjects/ascon129f/Ascon.wl\"]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
