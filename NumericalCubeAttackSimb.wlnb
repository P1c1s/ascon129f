n12*n4 + n13*n5 + n14*n6, 1 + k13 + k14 + k15 + k5 + k6 + k7 + n13 + n14 + n15 + n13*n5 + n14*n6 + n15*n7, 1 + k14 + k15 + k16 + k6 + k7 + k8 + n14 + n15 + n16 + n14*n6 + n15*n7 + n16*n8}, {1 + k1 + k15 + k16 + k7 + k8 + k9 + n16 + n8, 1 + k1 + k10 + k16 + k2 + k8 + k9 + n10 + n16 + n2 + n8, 1 + k1 + k10 + k11 + k2 + k3 + k9 + n10 + n2, 1 + k10 + k11 + k12 + k2 + k3 + k4 + n10 + n2, 1 + k11 + k12 + k13 + k3 + k4 + k5, 1 + k12 + k13 + k14 + k4 + k5 + k6 + n14 + n6, k13 + k14 + k15 + k5 + k6 + k7 + n14 + n6, 1 + k14 + k15 + k16 + k6 + k7 + k8 + n14 + n16 + n6 + n8}, {k6 + k8 + n1 + n14 + k6*n14 + n16 + k8*n16 + n6 + n8 + n9 + k1*n9, k2 + n1 + n10 + k2*n10 + n15 + k7*n15 + n2 + n7 + n9 + k1*n9, k2 + k8 + n10 + k2*n10 + n11 + k3*n11 + n16 + k8*n16 + n2 + n3 + n8, n1 + n11 + k3*n11 + n12 + k4*n12 + n3 + n4 + n9 + k1*n9, k2 + n10 + k2*n10 + n12 + k4*n12 + n13 + k5*n13 + n2 + n4 + n5, k6 + n11 + k3*n11 + n13 + k5*n13 + n14 + k6*n14 + n3 + n5 + n6, k6 + n12 + k4*n12 + n14 + k6*n14 + n15 + k7*n15 + n4 + n6 + n7, k8 + n13 + k5*n13 + n15 + k7*n15 + n16 + k8*n16 + n5 + n7 + n8}}]",
